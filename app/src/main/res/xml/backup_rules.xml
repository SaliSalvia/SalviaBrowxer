<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).
   A browser holds cookies, sessions, history and private-profile data; none of it may leave
   the device through backups. allowBackup is false in the manifest; these rules are a second,
   explicit line of defense.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
