<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing about a browsing session belongs in a backup: the downloaded queue, bookmarks,
  history, preferences and WebView cookies/cache all stay on this device only.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="Downloads" />
    <exclude domain="root" path="app_webview" />
    <exclude domain="root" path="app_textures" />
</full-backup-content>
