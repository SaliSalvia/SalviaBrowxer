<?xml version="1.0" encoding="utf-8"?>
<!--
  Applies to API 31+ (Android 12): the same exclusions as backup_rules.xml, for both
  cloud backup and device-to-device transfer. Browsing data never leaves the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="Downloads" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_textures" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="Downloads" />
        <exclude domain="root" path="app_webview" />
        <exclude domain="root" path="app_textures" />
    </device-transfer>
</data-extraction-rules>
