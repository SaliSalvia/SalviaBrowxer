<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SalviaBrowxer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/matte_charcoal</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
    </style>

    <!-- The launch theme: the splash draws its window over the same charcoal the app uses as its
         windowBackground, so the handoff to the first frame has no flash of a different colour.
         postSplashScreenTheme hands the activity back to the real theme the app is styled by. -->
    <style name="Theme.SalviaBrowxer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/matte_charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/salvia_brand</item>
        <item name="postSplashScreenTheme">@style/Theme.SalviaBrowxer</item>
    </style>
</resources>
