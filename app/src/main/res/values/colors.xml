<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Primary Palette -->
    <color name="matte_charcoal">#121214</color>
    <color name="deep_charcoal">#1B1B1F</color>
    <color name="gold">#D4AF37</color>
    <color name="violet">#8B5CF6</color>
    <color name="electric_indigo">#4F46E5</color>

    <!-- Material 3 Theme Colors -->
    <color name="primary">@color/gold</color>
    <color name="primary_container">@color/deep_charcoal</color>
    <color name="on_primary">@color/matte_charcoal</color>
    <color name="on_primary_container">@color/gold</color>

    <color name="secondary">@color/violet</color>
    <color name="secondary_container">@color/electric_indigo</color>
