    <color name="background">@color/matte_charcoal</color>
    <color name="on_background">@color/gold</color>
    <color name="surface">@color/deep_charcoal</color>
    <color name="on_surface">@color/gold</color>
    <color name="surface_variant">@color/electric_indigo</color>
    <color name="on_surface_variant">@color/violet</color>

    <color name="error">#FF5722</color>
    <color name="on_error">#FFFFFF</color>

    <!-- Semantic Colors -->
    <color name="media_detected_indicator">@color/violet</color>
    <color name="download_button_active">@color/gold</color>
    <color name="download_button_inactive">#4A4A4A</color>
    <color name="floating_button_background">@color/deep_charcoal</color>
